# Public HTTPS origin (no trailing slash). Paste the same value into
# Hubsom Settings → Owncast public URL, or rebuild with:
#   --dart-define=HUBSOM_OWNCAST_URL=https://live.example.com
PUBLIC_BASE_URL=https://live.example.com
DOMAIN=live.example.com

# Shared secret for POST /media/upload (X-Hubsom-Media-Token).
# Also set in the Flutter build / Settings as HUBSOM_OWNCAST_MEDIA_TOKEN.
HUBSOM_MEDIA_TOKEN=change-me

# Stock Owncast admin + single-stream key (fallback if nginx-rtmp is down).
OWNCAST_STREAM_KEY=hubsom
