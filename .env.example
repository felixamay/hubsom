# ============================================================
# Hubsom · Production configuration
# ============================================================

# Auth.js secret (required) — generate with: openssl rand -hex 32
AUTH_SECRET=

# Public app URL (needed for OAuth callbacks in production)
# AUTH_URL=http://localhost:3000

# --- Email/password works out of the box (credentials provider) ---

# --- Social sign-in (optional; enable any you configure) ---
# Google Cloud Console → OAuth 2.0 Client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Meta Developer → Facebook Login
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Apple Developer → Sign in with Apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# REQUIRED for live camera/mic (host + viewers)
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Catalog, users, streams, chat, and orders persist under .data/ locally.
# Swap these JSON stores for a managed database before multi-instance deploy.

# --- Huber delivery app (optional until connected) ---
# Outbound: Hubsom POSTs delivery offers to Huber
# HUBERS_API_BASE_URL=https://api.huber.example
# HUBERS_API_KEY=
# Inbound: Huber webhooks to /api/integrations/hubers/webhook
# HUBERS_WEBHOOK_SECRET=
# See docs/HUBERS_INTEGRATION.md

# ------------------------------------------------------------
# Optional later (cloud recording / replay storage)
# AGORA_CUSTOMER_ID=
# AGORA_CUSTOMER_SECRET=
# ------------------------------------------------------------
