# ============================================================
# Hubsom · Agora Live Streaming
# Get these from https://console.agora.io
# ============================================================

# REQUIRED for real camera/mic live video (host + viewers)
# Agora Console → Project Management → Create/select project → copy App ID
NEXT_PUBLIC_AGORA_APP_ID=

# REQUIRED if App Certificate is enabled on the Agora project (recommended)
# Agora Console → Project → App Certificate → Enable → copy Primary Certificate
AGORA_APP_CERTIFICATE=

# ------------------------------------------------------------
# Optional later (cloud recording / replay storage)
# Agora Console → RESTful API → Customer ID / Customer Secret
# AGORA_CUSTOMER_ID=
# AGORA_CUSTOMER_SECRET=
# AGORA_RECORDING_VENDOR=1
# AGORA_RECORDING_REGION=0
# ------------------------------------------------------------
