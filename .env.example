# ============================================================
# Hubsom · Production configuration
# ============================================================

# REQUIRED for live camera/mic (host + viewers)
# Agora Console → Project Management → App ID
NEXT_PUBLIC_AGORA_APP_ID=

# REQUIRED when App Certificate is enabled (recommended)
# Agora Console → Project → App Certificate → Primary Certificate
AGORA_APP_CERTIFICATE=

# Catalog, streams, chat, and orders persist under .data/ locally.
# Swap these JSON stores for a managed database before multi-instance deploy.

# ------------------------------------------------------------
# Optional later (cloud recording / replay storage)
# AGORA_CUSTOMER_ID=
# AGORA_CUSTOMER_SECRET=
# AGORA_RECORDING_VENDOR=1
# AGORA_RECORDING_REGION=0
# ------------------------------------------------------------
